# ==============================================================================
# EXPRESS CAR WASH — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Port numbers for proxy must be managed strictly via .env
PORT=3000
HOST=0.0.0.0

# 2. Allowed Hosts & Domain Names for Server Actions, Proxies & Vite
# Prevents "Blocked request. This host (expresscarfoamwash.com) is not allowed"
ALLOWED_HOSTS=expresscarfoamwash.com,www.expresscarfoamwash.com,localhost,127.0.0.1,0.0.0.0

# 3. Environment
NODE_ENV=production
